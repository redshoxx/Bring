# DNS: A/AAAA-Record dieser Domain auf deinen VPS richten.
APP_DOMAIN=alltag.deine-domain.at
# Mindestens 32 zufällige Zeichen, für die Datenbank-URL nur a-z/A-Z/0-9 verwenden.
DB_PASSWORD=BITTE_DURCH_LANGES_ZUFAELLIGES_PASSWORT_ERSETZEN
# Optional: Ohne API-Schlüssel funktionieren alle Funktionen außer automatischen Bildern.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
CORS_ORIGINS=
